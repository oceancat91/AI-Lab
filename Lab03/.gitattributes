# Source code uses LF. Evidence retains its original bytes (including CRLF).
# Rewriting evidence line endings would invalidate recorded SHA256 values.
*.py text eol=lf
*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.yml text eol=lf
*.txt -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
.gitattributes text eol=lf
*.pdf binary
*.png binary
